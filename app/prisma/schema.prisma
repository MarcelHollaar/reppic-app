generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
}

enum RoleStatus {
  active
  inactive
}

enum VideoStatus {
  active
  inactive
}

enum VideoType {
  General
  Example
  Exercise
}

enum TranslationType {
  video
  category
  tag
}

// Leer-as (LMS-integratie): onafhankelijk van de sales-rol (User.role).
// none = geen toegang tot leren; learner = volgt modules;
// learning_admin = beheert leren binnen eigen bedrijf (mensen, toewijzingen).
// Platform-superadmin (Role "superadmin") is impliciet ook leer-superadmin.
enum LearningRole {
  none
  learner
  learning_admin
}

model User {
  id             String       @id @default(uuid()) @map("id") @db.VarChar(40)
  name           String       @map("name") @db.VarChar(100)
  email          String       @unique @map("email") @db.VarChar(255)
  password       String?      @map("password") @db.VarChar(255)
  phone_number   String?      @map("phone_number") @db.VarChar(30)
  created_at     DateTime     @default(now()) @map("created_at")
  updated_at     DateTime     @updatedAt @map("updated_at")
  is_verified    Boolean      @default(false) @map("is_verified")
  status         UserStatus   @map("status")
  role_id        String       @map("role_id") @db.VarChar(40)
  company_id     String?      @map("company_id") @db.VarChar(40)
  avatar         String?      @map("avatar") @db.VarChar(255)
  manager_id     String?      @map("manager_id") @db.VarChar(40)
  password_token String?      @unique @map("password_token") @db.VarChar(255)
  lang_code      String?      @default("en") @map("lang_code") @db.VarChar(10)
  learning_role  LearningRole @default(learner) @map("learning_role")

  role                Role                @relation(fields: [role_id], references: [id])
  company             Company?            @relation(fields: [company_id], references: [id])
  manager             User?               @relation("UserManager", fields: [manager_id], references: [id]) // Direct manager
  team                User[]              @relation("UserManager") // Users managed by this user
  email_verifications EmailVerification[]
  password_resets     PasswordReset[]
  login_otps          LoginOtp[]
  trusted_devices     TrustedDevice[]
  user_settings       UserSetting[]
  suggested_videos    SuggestedVideo[]
  video_progress      VideoProgress[]
  user_conversations  UserConversation[]
  user_customers      Customer[]
  notifications       Notification[]
  uploaded_videos     Video[]             @relation("UploadedVideos")

  // LMS-integratie (leer-as)
  learning_progress         LearningProgress[]
  learning_certificates     LearningCertificate[]
  module_assignments        UserModuleAssignment[]
  learning_path_assignments UserLearningPathAssignment[]
  library_favorites         LibraryFavorite[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @map("id") @db.VarChar(40)
  name        String     @unique @map("name") @db.VarChar(100)
  description String     @map("description") @db.VarChar(255)
  status      RoleStatus @map("status")
  created_at  DateTime   @default(now()) @map("created_at")
  updated_at  DateTime   @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model EmailVerification {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id    String   @map("user_id") @db.VarChar(40)
  otp        String   @map("otp") @db.VarChar(6)
  created_at DateTime @default(now()) @map("created_at")
  expires_at DateTime @map("expires_at")

  user User @relation(fields: [user_id], references: [id])

  @@map("email_verifications")
}

model PasswordReset {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id    String   @map("user_id") @db.VarChar(40)
  otp        String   @map("otp") @db.VarChar(6)
  created_at DateTime @default(now()) @map("created_at")
  expires_at DateTime @map("expires_at")

  user User @relation(fields: [user_id], references: [id])

  @@map("password_resets")
}

model LoginOtp {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  // One live login-OTP per user. The unique constraint makes generation an
  // atomic upsert, so a race or double login-submit can never leave two codes
  // (which caused "first code rejected, second works").
  user_id    String   @unique @map("user_id") @db.VarChar(40)
  otp        String   @map("otp") @db.VarChar(6)
  created_at DateTime @default(now()) @map("created_at")
  expires_at DateTime @map("expires_at")

  user User @relation(fields: [user_id], references: [id])

  @@map("login_otps")
}

model TrustedDevice {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id    String   @map("user_id") @db.VarChar(40)
  token_hash String   @unique @map("token_hash") @db.VarChar(64)
  created_at DateTime @default(now()) @map("created_at")
  expires_at DateTime @map("expires_at")

  user User @relation(fields: [user_id], references: [id])

  @@map("trusted_devices")
}

model Customer {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id    String?  @map("user_id") @db.VarChar(40)
  name       String   @map("name") @db.VarChar(100)
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  user_conversations UserConversation[]
  user               User?              @relation(fields: [user_id], references: [id])

  @@map("customers")
}

// Gespreksvoorbereiding: blijvende eindklant-entiteit per tenant.
// domain = zakelijk e-maildomein van de klant, óf het volledige
// freemail-adres (prospect-per-persoon) — zie src/lib/prospect/resolveProspect.ts.
model ProspectAccount {
  id                 String   @id @default(uuid()) @map("id") @db.VarChar(40)
  company_id         String   @map("company_id") @db.VarChar(40)
  domain             String   @map("domain") @db.VarChar(255)
  name               String?  @map("name") @db.VarChar(255)
  crm_company_id     String?  @map("crm_company_id") @db.VarChar(64)
  created_at         DateTime @default(now()) @map("created_at")
  updated_at         DateTime @updatedAt @map("updated_at")

  company            Company            @relation(fields: [company_id], references: [id])
  user_conversations UserConversation[]
  conversation_preps ConversationPrep[]

  @@unique([company_id, domain], name: "prospect_account_company_domain_unique")
  @@map("prospect_accounts")
}

// Gespreksvoorbereiding: één rij per agenda-afspraak (calendar_event_id is
// de dedupe-sleutel — ook skips worden vastgelegd zodat de uurlijkse cron
// hetzelfde event niet blijft herevalueren).
// status: pending → generated → sent | skipped | failed
// skip_reason: no_sources | no_external_attendees | not_enough_context
model ConversationPrep {
  id                      String    @id @default(uuid()) @map("id") @db.VarChar(40)
  company_id              String    @map("company_id") @db.VarChar(40)
  user_id                 String    @map("user_id") @db.VarChar(40)
  prospect_account_id     String?   @map("prospect_account_id") @db.VarChar(40)
  calendar_event_id       String    @unique @map("calendar_event_id") @db.VarChar(255)
  meeting_title           String?   @map("meeting_title") @db.VarChar(255)
  meeting_start           DateTime  @map("meeting_start")
  source_conversation_ids Json      @map("source_conversation_ids")
  crm_deal_id             String?   @map("crm_deal_id") @db.VarChar(64)
  content                 Json?     @map("content")
  status                  String    @default("pending") @map("status") @db.VarChar(20)
  skip_reason             String?   @map("skip_reason") @db.VarChar(100)
  fail_count              Int       @default(0) @map("fail_count")
  email_sent_at           DateTime? @map("email_sent_at")
  created_at              DateTime  @default(now()) @map("created_at")
  updated_at              DateTime  @updatedAt @map("updated_at")

  prospect_account ProspectAccount? @relation(fields: [prospect_account_id], references: [id])

  @@index([company_id], name: "idx_conversation_preps_company")
  @@index([meeting_start], name: "idx_conversation_preps_meeting_start")
  @@map("conversation_preps")
}

// Admin-bewerkbare prompt voor de gespreksvoorbereiding — zelfde
// versioning-patroon als TranscriptAnalysisPromptVersion.
model PrepAnalysisPromptVersion {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  version    Int      @map("version")
  content    String   @map("content") @db.Text
  is_active  Boolean  @default(false) @map("is_active")
  note       String?  @map("note") @db.VarChar(500)
  created_by String?  @map("created_by") @db.VarChar(40)
  created_at DateTime @default(now()) @map("created_at")

  @@unique([version], name: "prep_analysis_prompt_version_unique")
  @@index([is_active], name: "idx_prep_analysis_prompt_active")
  @@map("prep_analysis_prompt_versions")
}

model UserConversation {
  id                     String    @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id                String    @map("user_id") @db.VarChar(40)
  customer_id            String?   @map("customer_id") @db.VarChar(40)
  title                  String?   @map("title") @db.VarChar(255)
  file_path              String?   @map("file_path") @db.VarChar(255)
  file_duration          Float?    @map("file_duration")
  meeting_date           DateTime? @map("meeting_date")
  meeting_time_start     String?   @map("meeting_time_start") @db.VarChar(5)
  meeting_time_end       String?   @map("meeting_time_end") @db.VarChar(5)
  twinai_run_id          String?   @map("twinai_run_id") @db.VarChar(255)
  twinai_run_status      String?   @map("twinai_run_status") @db.VarChar(255)
  evaluated_at           DateTime? @map("evaluated_at")
  created_at             DateTime  @default(now()) @map("created_at")
  updated_at             DateTime  @updatedAt @map("updated_at")
  notes                  String?   @map("notes") @db.Text
  conversation_status    String?   @map("conversation_status") @db.VarChar(50)
  from_device_id         String?   @map("from_device_id") @db.VarChar(255)
  transcript_text        String?   @map("transcript_text") @db.Text
  transcript_status      String?   @default("pending") @map("transcript_status") @db.VarChar(50)
  transcription_provider String?   @default("whisper") @map("transcription_provider") @db.VarChar(50)
  audio_retention_until  DateTime? @map("audio_retention_until")
  audio_deleted_at       DateTime? @map("audio_deleted_at")
  is_merging_chunks      Boolean   @default(false) @map("is_merging_chunks")
  // Gespreksvoorbereiding: deelnemers + koppeling aan de eindklant.
  attendee_emails        Json?     @map("attendee_emails")
  calendar_event_id      String?   @map("calendar_event_id") @db.VarChar(255)
  prospect_account_id    String?   @map("prospect_account_id") @db.VarChar(40)

  customer                 Customer?              @relation(fields: [customer_id], references: [id])
  user                     User                   @relation(fields: [user_id], references: [id])
  prospect_account         ProspectAccount?       @relation(fields: [prospect_account_id], references: [id])
  conversation_summaries   ConversationSummary[]
  conversation_summaries_x ConversationSummaryX[]

  @@index([prospect_account_id], name: "idx_user_conversations_prospect")
  @@map("user_conversations")
}

model VideoCategory {
  id          String   @id @default(uuid()) @map("id") @db.VarChar(40)
  name        String   @map("name") @db.VarChar(100)
  slug        String   @map("slug") @db.VarChar(100)
  description String?  @map("description") @db.VarChar(255)
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  @@map("video_categories")
}

model Video {
  id               String      @id @default(uuid()) @map("id") @db.VarChar(40)
  category_id      String      @map("category_id") @db.VarChar(40)
  title            String      @map("title") @db.VarChar(255)
  description      String?     @map("description")
  thumbnail_path   String?     @map("thumbnail_path") @db.VarChar(255)
  length           Int?        @map("length")
  uploaded_by      String      @map("uploaded_by") @db.VarChar(40)
  uploaded_by_user User        @relation("UploadedVideos", fields: [uploaded_by], references: [id])
  status           VideoStatus @map("status")
  phase            Int         @default(1) @map("phase")
  number           String      @map("number") @db.VarChar(40)
  type             VideoType   @default(General) @map("type")
  embedded_code    String      @default("") @map("embedded_code") @db.Text
  created_at       DateTime    @default(now()) @map("created_at")
  updated_at       DateTime    @updatedAt @map("updated_at")
  deleted_at       DateTime?   @map("deleted_at")

  category         Category         @relation("CategoryRelation", fields: [category_id], references: [id])
  tags             VideoTag[]       @relation("VideoTags")
  suggested_videos SuggestedVideo[]
  video_progress   VideoProgress[]

  @@map("videos")
}

model SuggestedVideo {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id    String   @map("user_id") @db.VarChar(40)
  video_id   String   @map("video_id") @db.VarChar(40)
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [user_id], references: [id])
  video Video @relation(fields: [video_id], references: [id])

  @@map("suggested_videos")
}

model UserSetting {
  id                   String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id              String   @map("user_id") @db.VarChar(40)
  notification_setting Json     @map("notification_setting")
  created_at           DateTime @default(now()) @map("created_at")
  updated_at           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [user_id], references: [id])

  @@map("user_settings")
}

model VideoProgress {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id    String   @map("user_id") @db.VarChar(40)
  video_id   String   @map("video_id") @db.VarChar(40)
  progress   Float    @map("progress") // Progress in seconds or percentage
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [user_id], references: [id])
  video Video @relation(fields: [video_id], references: [id])

  @@map("video_progress")
}

model ConversationSummary {
  id                           String   @id @default(uuid()) @map("id") @db.VarChar(40)
  conversation_id              String   @map("conversation_id") @db.VarChar(40)
  title                        String?  @map("title") @db.Text
  customer_type                String   @map("customer_type") @db.VarChar(50)
  phases                       Json     @map("phases")
  score                        Float    @map("score")
  salesperson_speak_percentage Float    @map("salesperson_speak_percentage")
  questions_asked              Int      @default(0) @map("questions_asked")
  summary                      String   @map("summary") @db.Text
  learning_points              Json     @map("learning_points")
  custom_data                  Json     @map("custom_data")
  created_at                   DateTime @default(now()) @map("created_at")
  updated_at                   DateTime @updatedAt @map("updated_at")
  atmosphere                   String?  @map("atmosphere") @db.VarChar(50)

  user_conversation UserConversation @relation(fields: [conversation_id], references: [id])

  @@map("conversation_summaries")
}

model ConversationSummaryX {
  id                     String   @id @default(uuid()) @map("id") @db.VarChar(40)
  conversation_id        String   @map("conversation_id") @db.VarChar(40)
  transcribed_text       String?  @map("transcribed_text") @db.Text
  learning_points        String[] @map("learning_points")
  mail_text              String?  @map("mail_text") @db.Text
  summary_text           String?  @map("summary_text") @db.Text
  resistance_text        String?  @map("resistance_text") @db.Text
  salesperson_percentage Int?     @map("salesperson_percentage")
  atmosphere             String?  @map("atmosphere") @db.VarChar(50)
  total_score            Float?   @map("total_score")
  phases                 Json?    @map("phases")
  resistances            Json?    @map("resistances")
  customer_type          String?  @map("customer_type") @db.VarChar(50)
  // True when the analysis classified this as NOT an analyzable sales
  // conversation. Such conversations must never count toward any assessment:
  // excluded from the personal PICA dashboard and not pushed to the
  // operational/strategic dashboards.
  geen_salesgesprek      Boolean  @default(false) @map("geen_salesgesprek")
  created_at             DateTime @default(now()) @map("created_at")
  updated_at             DateTime @updatedAt @map("updated_at")

  user_conversation UserConversation @relation(fields: [conversation_id], references: [id])

  @@map("conversation_summaries_x")
}

model Notification {
  id             String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id        String   @map("user_id") @db.VarChar(40)
  type           String   @map("type") @db.VarChar(50)
  message        String   @map("message")
  reference_id   String?  @map("reference_id") @db.VarChar(40)
  reference_type String?  @map("reference_type") @db.VarChar(50)
  is_read        Boolean  @default(false) @map("is_read")
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model Prompt {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  lang_code  String   @map("lang_code") @db.VarChar(10)
  prompt     String   @map("prompt") @db.Text
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([lang_code], name: "idx_prompt_lang")
  @@map("prompts")
}

model Company {
  id                   String  @id @default(uuid()) @map("id") @db.VarChar(40)
  title                String  @map("title") @db.VarChar(100)
  contact_person       String  @map("contact_person") @db.VarChar(100)
  email                String  @map("email") @db.VarChar(100)
  phone                String  @map("phone") @db.VarChar(100)
  notes                String  @map("notes") @db.Text
  max_users            Int     @default(0) @map("max_users")
  // LMS-integratie: volledig-LMS aan/uit per bedrijf + Kennisbibliotheek-add-on
  lms_enabled          Boolean @default(false) @map("lms_enabled")
  has_knowledge_access Boolean @default(false) @map("has_knowledge_access")
  // Gespreksvoorbereiding: automatische prep-mails aan/uit (gefaseerde rollout)
  meeting_prep_enabled Boolean @default(false) @map("meeting_prep_enabled")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  users User[]

  // LMS-integratie
  job_roles           JobRole[]
  learning_categories LearningCategory[]
  learning_modules    LearningModule[]
  learning_paths      LearningPath[]
  library_categories  LibraryCategory[]
  library_documents   LibraryDocument[]
  // Gespreksvoorbereiding
  prospect_accounts ProspectAccount[]

  @@unique([email, title], name: "email_title_unique")
  @@map("companies")
}

model Category {
  id         String    @id @default(uuid()) @map("id") @db.VarChar(40)
  name       String    @map("name") @db.VarChar(150)
  slug       String    @map("slug") @db.VarChar(100)
  status     String    @default("active") @map("status") @db.VarChar(50)
  created_at DateTime  @default(now()) @map("created_at")
  updated_at DateTime  @updatedAt @map("updated_at")
  deleted_at DateTime? @map("deleted_at")

  videos Video[] @relation("CategoryRelation")

  @@map("categories")
}

model Tag {
  id         String    @id @default(uuid()) @map("id") @db.VarChar(40)
  name       String    @map("name") @db.VarChar(150)
  slug       String    @map("slug") @db.VarChar(100)
  status     String    @default("active") @map("status") @db.VarChar(50)
  created_at DateTime  @default(now()) @map("created_at")
  updated_at DateTime  @updatedAt @map("updated_at")
  deleted_at DateTime? @map("deleted_at")

  videos VideoTag[] @relation("VideoTags")

  @@map("tags")
}

model VideoTag {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  video_id   String   @map("video_id") @db.VarChar(40)
  tag_id     String   @map("tag_id") @db.VarChar(40)
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  video Video @relation("VideoTags", fields: [video_id], references: [id])
  tag   Tag   @relation("VideoTags", fields: [tag_id], references: [id])

  @@unique([video_id, tag_id], name: "unique_video_tag")
  @@map("video_tags")
}

model TitleTranslation {
  id            String          @id @default(uuid()) @map("id") @db.VarChar(40)
  lang_code     String          @map("lang_code") @db.VarChar(10)
  type          TranslationType @map("type")
  type_id       String          @map("type_id") @db.VarChar(50)
  value         String          @map("value") @db.VarChar(50)
  embedded_code String          @default("") @map("embedded_code") @db.Text
  created_at    DateTime        @default(now()) @map("created_at")
  updated_at    DateTime        @updatedAt @map("updated_at")
  deleted_at    DateTime?       @map("deleted_at")

  @@unique([type, type_id, lang_code], name: "type_type_id_lang_code")
  @@map("title_translations")
}

model PlatformSetting {
  key        String   @id @db.VarChar(64)
  // Text i.p.v. VarChar(255): sommige instellingen (bv. de meertalige
  // agenda-disclaimer als JSON) zijn langer dan 255 tekens.
  value      String   @db.Text
  updated_at DateTime @updatedAt

  @@map("platform_settings")
}

model TranscriptAnalysisPromptVersion {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  version    Int      @map("version")
  content    String   @map("content") @db.Text
  is_active  Boolean  @default(false) @map("is_active")
  note       String?  @map("note") @db.VarChar(500)
  created_by String?  @map("created_by") @db.VarChar(40)
  created_at DateTime @default(now()) @map("created_at")

  @@unique([version], name: "transcript_analysis_prompt_version_unique")
  @@index([is_active], name: "idx_transcript_analysis_prompt_active")
  @@map("transcript_analysis_prompt_versions")
}

// Gespreksvoorbereiding: CRM-koppeling per tenant (Company). Eén actieve CRM
// per bedrijf; `provider` bepaalt welke (hubspot | salesforce | dynamics).
// Tokens staan encrypted-at-rest via src/lib/crypto/secretBox.ts
// (ENCRYPTION_KEY). status: active | broken (refresh geweigerd; opnieuw
// verbinden nodig). external_account_id = portal-id (HubSpot) / org-id
// (Salesforce/Dynamics). instance_url = per-connectie API-basis voor
// Salesforce (instance_url) en Dynamics (org-URL); null voor HubSpot.
model CrmConnection {
  id                  String   @id @default(uuid()) @map("id") @db.VarChar(40)
  company_id          String   @unique @map("company_id") @db.VarChar(40)
  provider            String   @map("provider") @db.VarChar(20)
  external_account_id String   @map("external_account_id") @db.VarChar(64)
  instance_url        String?  @map("instance_url") @db.Text
  access_token_enc    String   @map("access_token_enc") @db.Text
  refresh_token_enc   String   @map("refresh_token_enc") @db.Text
  expires_at          DateTime @map("expires_at")
  scopes              String?  @map("scopes") @db.Text
  status              String   @default("active") @map("status") @db.VarChar(20)
  connected_by        String?  @map("connected_by") @db.VarChar(40)
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt @map("updated_at")

  @@map("crm_connections")
}

model DesktopSdkUpload {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  upload_id  String   @unique @map("upload_id") @db.VarChar(64)
  user_id    String   @map("user_id") @db.VarChar(40)
  status     String   @default("pending") @map("status") @db.VarChar(20)
  created_at DateTime @default(now()) @map("created_at")

  @@index([user_id], name: "idx_desktop_sdk_uploads_user")
  @@map("desktop_sdk_uploads")
}

/// Idempotentie voor het maandelijkse manager-rapport: één rij per
/// (bedrijf, periode). Een herstart/dubbele cron-aanroep verstuurt zo nooit
/// twee keer dezelfde maandmail.
model MonthlyReportRun {
  id               String   @id @default(uuid()) @map("id") @db.VarChar(40)
  company_id       String   @map("company_id") @db.VarChar(40)
  /// Periode-sleutel, bijv. "2026-07"
  period           String   @map("period") @db.VarChar(7)
  recipients_count Int      @default(0) @map("recipients_count")
  created_at       DateTime @default(now()) @map("created_at")

  @@unique([company_id, period])
  @@map("monthly_report_runs")
}

model CompanyTerminology {
  id              String   @id @default(uuid()) @map("id") @db.VarChar(40)
  company_id      String   @unique @map("company_id") @db.VarChar(40)
  mapping         Json     @map("mapping")
  /// Bedrijfsspecifieke productnamen/kernbegrippen voor transcriptie-keyterms
  /// (AssemblyAI keyterms_prompt). String-array in JSON.
  product_terms   Json     @default("[]") @map("product_terms")
  source_filename String?  @map("source_filename") @db.VarChar(255)
  updated_by      String?  @map("updated_by") @db.VarChar(40)
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  @@map("company_terminology")
}

// ============================================================
// LMS-integratie (Fase 2) — leerdomein, geport uit Reppic-LMS
// (shared/schema.ts, Drizzle) naar app-conventies.
// Identiteit (users/companies) komt uit de bestaande app-tabellen.
// ============================================================

enum LearningPathType {
  sales_skills
  knowledge
}

enum LearningContentType {
  video
  presentation
  document
}

enum LearningProgressStatus {
  not_started
  in_progress
  completed
}

model JobRole {
  id          String   @id @default(uuid()) @map("id") @db.VarChar(40)
  name        String   @map("name") @db.VarChar(150)
  description String?  @map("description") @db.Text
  scope       String   @default("company") @map("scope") @db.VarChar(20) // 'global' | 'company'
  company_id  String?  @map("company_id") @db.VarChar(40) // NULL = globale template
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  company          Company?        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  module_job_roles ModuleJobRole[]
  learning_paths   LearningPath[]

  @@map("job_roles")
}

model LearningCategory {
  id                 String           @id @default(uuid()) @map("id") @db.VarChar(40)
  name               String           @map("name") @db.VarChar(150)
  description        String?          @map("description") @db.Text
  learning_path_type LearningPathType @default(knowledge) @map("learning_path_type")
  company_id         String?          @map("company_id") @db.VarChar(40) // NULL = globaal (superadmin)
  sort_order         Int              @default(0) @map("sort_order")
  created_by         String?          @map("created_by") @db.VarChar(40)
  created_at         DateTime         @default(now()) @map("created_at")
  updated_at         DateTime         @updatedAt @map("updated_at")

  company Company?         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  modules LearningModule[]

  @@unique([learning_path_type, company_id, name], name: "learning_category_scope_unique")
  @@map("learning_categories")
}

model LearningModule {
  id                 String              @id @default(uuid()) @map("id") @db.VarChar(40)
  title              String              @map("title") @db.VarChar(255)
  description        String              @map("description") @db.Text
  duration           Int                 @default(0) @map("duration") // minuten
  category_id        String?             @map("category_id") @db.VarChar(40)
  learning_path_type LearningPathType    @default(knowledge) @map("learning_path_type")
  phase              Int?                @map("phase") // alleen sales_skills: gespreksfase 1-8
  company_id         String?             @map("company_id") @db.VarChar(40) // NULL = globaal
  is_required        Boolean             @default(false) @map("is_required")
  content_type       LearningContentType @default(video) @map("content_type")
  video_url          String?             @map("video_url") @db.Text
  video_embed_code   String?             @map("video_embed_code") @db.Text
  thumbnail_url      String?             @map("thumbnail_url") @db.Text
  original_language  String              @default("en") @map("original_language") @db.VarChar(10)
  competency_tags    Json?               @map("competency_tags")
  competency_summary String?             @map("competency_summary") @db.Text
  created_by         String?             @map("created_by") @db.VarChar(40)
  created_at         DateTime            @default(now()) @map("created_at")
  updated_at         DateTime            @updatedAt @map("updated_at")
  deleted_at         DateTime?           @map("deleted_at")

  company                    Company?                    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  category                   LearningCategory?           @relation(fields: [category_id], references: [id], onDelete: SetNull)
  questions                  LearningQuestion[]
  progress                   LearningProgress[]
  certificates               LearningCertificate[]
  module_job_roles           ModuleJobRole[]
  path_modules               LearningPathModule[]
  module_assignments         UserModuleAssignment[]
  translations               LearningModuleTranslation[]

  @@index([company_id], name: "idx_learning_modules_company")
  @@index([learning_path_type], name: "idx_learning_modules_path_type")
  embedding LearningModuleEmbedding?

  @@map("learning_modules")
}

model LearningQuestion {
  id             String  @id @default(uuid()) @map("id") @db.VarChar(40)
  module_id      String  @map("module_id") @db.VarChar(40)
  question       String  @map("question") @db.Text
  options        Json    @map("options") // array van antwoordopties
  correct_answer Int     @map("correct_answer") // index in options
  explanation    String? @map("explanation") @db.Text
  image_url      String? @map("image_url") @db.Text
  order_index    Int     @default(0) @map("order_index")

  module LearningModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([module_id], name: "idx_learning_questions_module")
  @@map("learning_questions")
}

model LearningProgress {
  id               String                 @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id          String                 @map("user_id") @db.VarChar(40)
  module_id        String                 @map("module_id") @db.VarChar(40)
  status           LearningProgressStatus @default(not_started) @map("status")
  progress         Int                    @default(0) @map("progress") // percentage 0-100
  score            Int?                   @map("score") // quizscore percentage
  answers          Json?                  @map("answers")
  time_spent       Int                    @default(0) @map("time_spent") // minuten
  started_at       DateTime?              @map("started_at")
  completed_at     DateTime?              @map("completed_at")
  last_accessed_at DateTime               @default(now()) @map("last_accessed_at")

  user   User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  module LearningModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([user_id, module_id], name: "learning_progress_user_module_unique")
  @@map("learning_progress")
}

model LearningCertificate {
  id                 String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id            String   @map("user_id") @db.VarChar(40)
  module_id          String   @map("module_id") @db.VarChar(40)
  certificate_number String   @unique @map("certificate_number") @db.VarChar(64)
  score              Int      @map("score")
  completed_at       DateTime @default(now()) @map("completed_at")

  user   User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  module LearningModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_learning_certificates_user")
  @@map("learning_certificates")
}

model LearningPath {
  id           String   @id @default(uuid()) @map("id") @db.VarChar(40)
  job_function String   @map("job_function") @db.VarChar(150)
  level        String   @map("level") @db.VarChar(50)
  description  String?  @map("description") @db.Text
  job_role_id  String?  @map("job_role_id") @db.VarChar(40)
  company_id   String?  @map("company_id") @db.VarChar(40) // NULL = globaal
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt @map("updated_at")

  company          Company?                     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  job_role         JobRole?                     @relation(fields: [job_role_id], references: [id], onDelete: SetNull)
  path_modules     LearningPathModule[]
  path_assignments UserLearningPathAssignment[]

  competency LearningPathCompetency?

  @@map("learning_paths")
}

model LearningPathModule {
  id               String @id @default(uuid()) @map("id") @db.VarChar(40)
  learning_path_id String @map("learning_path_id") @db.VarChar(40)
  module_id        String @map("module_id") @db.VarChar(40)
  order_index      Int    @default(0) @map("order_index")

  learning_path LearningPath   @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)
  module        LearningModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([learning_path_id, module_id], name: "learning_path_module_unique")
  @@map("learning_path_modules")
}

model ModuleJobRole {
  id          String   @id @default(uuid()) @map("id") @db.VarChar(40)
  module_id   String   @map("module_id") @db.VarChar(40)
  job_role_id String   @map("job_role_id") @db.VarChar(40)
  visibility  String   @default("required") @map("visibility") @db.VarChar(20) // 'required' | 'recommended'
  created_at  DateTime @default(now()) @map("created_at")

  module   LearningModule @relation(fields: [module_id], references: [id], onDelete: Cascade)
  job_role JobRole        @relation(fields: [job_role_id], references: [id], onDelete: Cascade)

  @@unique([module_id, job_role_id], name: "module_job_role_unique")
  @@map("module_job_roles")
}

model UserModuleAssignment {
  id          String    @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id     String    @map("user_id") @db.VarChar(40)
  module_id   String    @map("module_id") @db.VarChar(40)
  assigned_by String?   @map("assigned_by") @db.VarChar(40)
  assigned_at DateTime  @default(now()) @map("assigned_at")
  due_date    DateTime? @map("due_date")
  is_required Boolean   @default(true) @map("is_required")

  user   User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  module LearningModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([user_id, module_id], name: "user_module_assignment_unique")
  @@map("user_module_assignments")
}

model UserLearningPathAssignment {
  id               String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id          String   @map("user_id") @db.VarChar(40)
  learning_path_id String   @map("learning_path_id") @db.VarChar(40)
  assigned_by      String?  @map("assigned_by") @db.VarChar(40)
  assigned_at      DateTime @default(now()) @map("assigned_at")

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  learning_path LearningPath @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)

  @@unique([user_id, learning_path_id], name: "user_learning_path_assignment_unique")
  @@map("user_learning_path_assignments")
}

// Kennisbibliotheek (add-on, gate = Company.has_knowledge_access)
model LibraryCategory {
  id          String   @id @default(uuid()) @map("id") @db.VarChar(40)
  name        String   @map("name") @db.VarChar(150)
  description String?  @map("description") @db.Text
  icon        String?  @map("icon") @db.VarChar(50)
  company_id  String   @map("company_id") @db.VarChar(40)
  sort_order  Int      @default(0) @map("sort_order")
  created_by  String?  @map("created_by") @db.VarChar(40)
  created_at  DateTime @default(now()) @map("created_at")

  company   Company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  documents LibraryDocument[]

  @@map("library_categories")
}

model LibraryDocument {
  id            String   @id @default(uuid()) @map("id") @db.VarChar(40)
  title         String   @map("title") @db.VarChar(255)
  description   String?  @map("description") @db.Text
  category_id   String?  @map("category_id") @db.VarChar(40)
  company_id    String   @map("company_id") @db.VarChar(40)
  content_type  String   @default("document") @map("content_type") @db.VarChar(20) // 'document' | 'video' | 'presentation' | 'link'
  file_url      String?  @map("file_url") @db.Text
  external_url  String?  @map("external_url") @db.Text
  thumbnail_url String?  @map("thumbnail_url") @db.Text
  file_size     Int?     @map("file_size")
  mime_type     String?  @map("mime_type") @db.VarChar(100)
  tags          Json?    @map("tags")
  is_published  Boolean  @default(true) @map("is_published")
  view_count    Int      @default(0) @map("view_count")
  uploaded_by   String?  @map("uploaded_by") @db.VarChar(40)
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")

  company   Company                   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  category  LibraryCategory?          @relation(fields: [category_id], references: [id], onDelete: SetNull)
  favorites LibraryFavorite[]
  embedding LibraryDocumentEmbedding?

  @@index([company_id], name: "idx_library_documents_company")
  @@map("library_documents")
}

model LibraryFavorite {
  id          String   @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id     String   @map("user_id") @db.VarChar(40)
  document_id String   @map("document_id") @db.VarChar(40)
  created_at  DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document LibraryDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([user_id, document_id], name: "library_favorite_unique")
  @@map("library_favorites")
}

// AI-uitbreiding: embeddings voor semantisch zoeken in de Kennisbibliotheek.
// Opslag als JSON-string van de vector (zelfde aanpak als het oude LMS);
// model/dimensie configureerbaar via LEARNING_EMBEDDINGS_MODEL.
model LibraryDocumentEmbedding {
  id           String   @id @default(uuid()) @map("id") @db.VarChar(40)
  document_id  String   @unique @map("document_id") @db.VarChar(40)
  company_id   String   @map("company_id") @db.VarChar(40)
  embedding    String   @map("embedding") @db.Text
  text_content String?  @map("text_content") @db.Text
  model        String   @map("model") @db.VarChar(100)
  indexed_at   DateTime @default(now()) @map("indexed_at")
  updated_at   DateTime @updatedAt @map("updated_at")

  document LibraryDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([company_id], name: "idx_library_doc_embeddings_company")
  @@map("library_document_embeddings")
}

// AI-uitbreiding: meertalige module-content (port van het oude LMS
// translations-mechanisme). content = { title, description,
// questions: [{ question, options[], explanation }] } in de doeltaal.
model LearningModuleTranslation {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  module_id  String   @map("module_id") @db.VarChar(40)
  language   String   @map("language") @db.VarChar(10)
  content    Json     @map("content")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  module LearningModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([module_id, language], name: "learning_module_translation_unique")
  @@map("learning_module_translations")
}

// LMS 1:1 P3 — Help-center (port van productie HelpCategory/HelpArticle).
// Artikelen per rol (all/learner/admin), taal en optionele paginacontext;
// beheer door learning_admin/superadmin.
model HelpCategory {
  id          String   @id @default(uuid()) @map("id") @db.VarChar(40)
  name        String   @map("name") @db.Text
  description String?  @map("description") @db.Text
  icon        String?  @map("icon") @db.Text
  sort_order  Int      @default(0) @map("sort_order")
  created_at  DateTime @default(now()) @map("created_at")

  articles HelpArticle[]

  @@map("help_categories")
}

model HelpArticle {
  id           String   @id @default(uuid()) @map("id") @db.VarChar(40)
  category_id  String?  @map("category_id") @db.VarChar(40)
  title        String   @map("title") @db.Text
  content      String   @map("content") @db.Text
  excerpt      String?  @map("excerpt") @db.Text
  page_context String?  @map("page_context") @db.Text
  target_role  String   @default("all") @map("target_role") @db.Text
  language     String   @default("en") @map("language") @db.Text
  is_published Boolean  @default(true) @map("is_published")
  sort_order   Int      @default(0) @map("sort_order")
  view_count   Int      @default(0) @map("view_count")
  created_by   String?  @map("created_by") @db.VarChar(40)
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @default(now()) @updatedAt @map("updated_at")

  category HelpCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([page_context], name: "idx_help_articles_page_context")
  @@map("help_articles")
}

// LMS 1:1 P4 — embedding-gebaseerde module-matching (port van productie
// ModuleEmbedding + LearningPathCompetency). Embedding als JSON-string,
// zelfde aanpak als LibraryDocumentEmbedding.
model LearningModuleEmbedding {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(40)
  module_id  String   @unique @map("module_id") @db.VarChar(40)
  embedding  String   @map("embedding") @db.Text
  model      String   @map("model") @db.VarChar(100)
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  module LearningModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@map("learning_module_embeddings")
}

// Competenties die bij een AI-gegenereerd leerpad zijn gebruikt (audit +
// herberekening), port van productie learning_path_competencies.
model LearningPathCompetency {
  id               String   @id @default(uuid()) @map("id") @db.VarChar(40)
  learning_path_id String   @unique @map("learning_path_id") @db.VarChar(40)
  competencies     Json     @map("competencies")
  job_profile_text String?  @map("job_profile_text") @db.Text
  created_at       DateTime @default(now()) @map("created_at")

  learning_path LearningPath @relation(fields: [learning_path_id], references: [id], onDelete: Cascade)

  @@map("learning_path_competencies")
}

// LMS 1:1 P5 — media-bibliotheek / Brand Kit (port van productie MediaItem).
// company_id NULL = globale media (superadmin, sales-skills); anders
// bedrijfsmedia (learning_admin, knowledge). pdf_url = automatisch
// geconverteerde PDF van Office-bestanden (LibreOffice).
model LearningMediaItem {
  id          String   @id @default(uuid()) @map("id") @db.VarChar(40)
  name        String   @map("name") @db.Text
  type        String   @map("type") @db.Text
  url         String   @map("url") @db.Text
  pdf_url     String?  @map("pdf_url") @db.Text
  file_size   Int?     @map("file_size")
  mime_type   String?  @map("mime_type") @db.Text
  tags        Json?    @map("tags")
  company_id  String?  @map("company_id") @db.VarChar(40)
  uploaded_by String?  @map("uploaded_by") @db.VarChar(40)
  created_at  DateTime @default(now()) @map("created_at")

  @@index([company_id], name: "idx_media_items_company")
  @@map("media_items")
}

// LMS 1:1 P6 — losse competentietags voor leermodules (port van productie
// Tag; tabel heet learning_tags omdat "tags" al door video-tags bezet is).
model LearningTag {
  id          String   @id @default(uuid()) @map("id") @db.VarChar(40)
  name        String   @unique @map("name") @db.Text
  category    String?  @map("category") @db.Text
  description String?  @map("description") @db.Text
  created_by  String?  @map("created_by") @db.VarChar(40)
  usage_count Int      @default(0) @map("usage_count")
  created_at  DateTime @default(now()) @map("created_at")

  @@map("learning_tags")
}

// LMS 1:1 P6 — onboarding-tourvoortgang (port van productie UserTourProgress;
// in productie alleen API, geen UI — hier idem).
model UserTourProgress {
  id           String    @id @default(uuid()) @map("id") @db.VarChar(40)
  user_id      String    @map("user_id") @db.VarChar(40)
  tour_id      String    @map("tour_id") @db.Text
  completed    Boolean   @default(false) @map("completed")
  current_step Int       @default(0) @map("current_step")
  completed_at DateTime? @map("completed_at")
  updated_at   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([user_id, tour_id], name: "user_tour_unique")
  @@map("user_tour_progress")
}
