FROM node:20

RUN apt-get update && apt-get install -y ffmpeg

WORKDIR /usr/src/app


ARG DATABASE_URL
ARG NODE_ENV
ARG JWT_SECRET
ARG APP_NAME
ARG FROM_MAIL
ARG SMTP_HOST
ARG SMTP_PORT
ARG SMTP_USER
ARG SMTP_PASS
ARG FFMPEG_PATH
ARG FFPROBE_PATH
ARG APP_URL
ARG LITELLM_BASE_URL
ARG LITELLM_API_KEY
ARG LITELLM_MODEL
ARG LITELLM_TAG
ARG FTP_HOST
ARG FTP_USER
ARG FTP_PASSWORD
ARG FTP_SECURE
ARG FTP_PUBLIC_URL
ARG FTP_WEB_ROOT
ARG NEXT_PUBLIC_FTP_PUBLIC_URL
ARG NEXT_PUBLIC_NODE_ENV
ARG WEBHOOK_SECRET_KEY
ARG WEBHOOK_SIGNING_SECRET
ARG SURECART_API_SECRET_KEY
ARG LIVEAVATAR_API_KEY
ARG LIVEAVATAR_AVATAR_ID
ARG LIVEAVATAR_VOICE_ID
ARG OPENAI_API_KEY
ARG TRANSCRIPTION_PROVIDER
ARG ASSEMBLYAI_API_KEY
ARG APP_BASE_URL
ARG NEXT_PUBLIC_AXIOM_TOKEN
ARG NEXT_PUBLIC_AXIOM_DATASET
ARG NEXT_PUBLIC_LMS_URL
ARG ENVIRONMENT
ARG RECORDINGS_FOLDER
ARG RECALL_API_KEY
ARG RECALL_WEBHOOK_SECRET
ARG RECALL_SDK_WEBHOOK_SECRET
ARG EXCEL_DATA_FTP_FOLDER
ARG LMS_API_URL
ARG LMS_WEBHOOK_SECRET
ARG LMS_SYNC_FAILURE_EMAILS
ARG NEXT_PUBLIC_DASHBOARD_API_URL
ARG DASHBOARD_API_URL

ENV DATABASE_URL=$DATABASE_URL
ENV NODE_ENV=$NODE_ENV
ENV JWT_SECRET=$JWT_SECRET
ENV APP_NAME=$APP_NAME
ENV FROM_MAIL=$FROM_MAIL
ENV SMTP_HOST=$SMTP_HOST
ENV SMTP_PORT=$SMTP_PORT
ENV SMTP_USER=$SMTP_USER
ENV SMTP_PASS=$SMTP_PASS
ENV FFMPEG_PATH=$FFMPEG_PATH
ENV FFPROBE_PATH=$FFPROBE_PATH
ENV APP_URL=$APP_URL
ENV LITELLM_BASE_URL=$LITELLM_BASE_URL
ENV LITELLM_API_KEY=$LITELLM_API_KEY
ENV LITELLM_MODEL=$LITELLM_MODEL
ENV LITELLM_TAG=$LITELLM_TAG
ENV FTP_HOST=$FTP_HOST
ENV FTP_USER=$FTP_USER
ENV FTP_PASSWORD=$FTP_PASSWORD
ENV FTP_SECURE=$FTP_SECURE
ENV FTP_PUBLIC_URL=$FTP_PUBLIC_URL
ENV FTP_WEB_ROOT=$FTP_WEB_ROOT
ENV NEXT_PUBLIC_FTP_PUBLIC_URL=$NEXT_PUBLIC_FTP_PUBLIC_URL
ENV NEXT_PUBLIC_NODE_ENV=$NEXT_PUBLIC_NODE_ENV
ENV WEBHOOK_SECRET_KEY=$WEBHOOK_SECRET_KEY
ENV WEBHOOK_SIGNING_SECRET=$WEBHOOK_SIGNING_SECRET
ENV SURECART_API_SECRET_KEY=$SURECART_API_SECRET_KEY
ENV LIVEAVATAR_API_KEY=$LIVEAVATAR_API_KEY
ENV LIVEAVATAR_AVATAR_ID=$LIVEAVATAR_AVATAR_ID
ENV LIVEAVATAR_VOICE_ID=$LIVEAVATAR_VOICE_ID
ENV OPENAI_API_KEY=$OPENAI_API_KEY
ENV TRANSCRIPTION_PROVIDER=$TRANSCRIPTION_PROVIDER
ENV ASSEMBLYAI_API_KEY=$ASSEMBLYAI_API_KEY
ENV APP_BASE_URL=$APP_BASE_URL
ENV NEXT_PUBLIC_AXIOM_TOKEN=$NEXT_PUBLIC_AXIOM_TOKEN
ENV NEXT_PUBLIC_AXIOM_DATASET=$NEXT_PUBLIC_AXIOM_DATASET
ENV NEXT_PUBLIC_LMS_URL=$NEXT_PUBLIC_LMS_URL
ENV ENVIRONMENT=$ENVIRONMENT
ENV RECORDINGS_FOLDER=$RECORDINGS_FOLDER
ENV RECALL_API_KEY=$RECALL_API_KEY
ENV RECALL_WEBHOOK_SECRET=$RECALL_WEBHOOK_SECRET
ENV RECALL_SDK_WEBHOOK_SECRET=$RECALL_SDK_WEBHOOK_SECRET
ENV EXCEL_DATA_FTP_FOLDER=$EXCEL_DATA_FTP_FOLDER
ENV LMS_API_URL=$LMS_API_URL
ENV LMS_WEBHOOK_SECRET=$LMS_WEBHOOK_SECRET
ENV LMS_SYNC_FAILURE_EMAILS=$LMS_SYNC_FAILURE_EMAILS
ENV NEXT_PUBLIC_DASHBOARD_API_URL=$NEXT_PUBLIC_DASHBOARD_API_URL
ENV DASHBOARD_API_URL=$DASHBOARD_API_URL

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run generate
RUN NODE_OPTIONS=--max-old-space-size=3072 npm run build

CMD ["npm", "start"]