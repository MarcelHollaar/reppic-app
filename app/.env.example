PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
# Generate a strong value: openssl rand -hex 32 (MUST match between app and dashboard-backend)
JWT_SECRET=

# SalesCoach / LiveAvatar
# Server-side API key for LiveAvatar
# Get one at https://app.liveavatar.com (Settings page)
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=

APP_URL=http://localhost:3000

# LiteLLM (conversation analysis)
LITELLM_BASE_URL=https://llm-reppic.mytestpartner.nl
LITELLM_API_KEY=
LITELLM_MODEL=twinai/medium
LITELLM_TAG=baseline
# Optional override for non-thinking routes (thinking routes always use 1)
# LITELLM_TEMPERATURE=0

APP_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

FFMPEG_PATH=
FFPROBE_PATH=

TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
# NIET MEER IN GEBRUIK (rollback 2026-07-22): de authenticatie op
# /api/webhooks/assemblyai is verwijderd, dus deze waarde wordt door de app
# genegeerd en mag leeg blijven of weg. Let op: de gelijknamige variabele in
# dashboard-backend/.env hoort bij een ANDER endpoint en is daar wel actief.
# Zie SECURITY-FIXES.md -> "ROLLBACK 2026-07-22".
ASSEMBLYAI_WEBHOOK_SECRET=

# Optional: exact allowed CORS origin for /api/* (e.g. https://app.reppic.ai).
# When set, credentialed CORS is enabled for that origin; when empty, the API
# responds with a non-credentialed "*" instead of the invalid "*"+credentials.
CORS_ALLOW_ORIGIN=

FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_PUBLIC_URL=
FTP_WEB_ROOT=httpdocs
# LMS-media (modulevideo/thumbnail/document) komt in deze DAM-submap:
# <FTP_WEB_ROOT>/<FTP_FOLDER_LMS>/public/… . Default "lms-reppic" (= dezelfde
# map als de geïmporteerde productie-content). Optioneel.
FTP_FOLDER_LMS=lms-reppic

NEXT_PUBLIC_FTP_PUBLIC_URL=
NEXT_PUBLIC_APP_NAME="Reppic"

NEXT_PUBLIC_NODE_ENV=
APP_BASE_URL=

# Dashboard backend (strategic & operational sales dashboards)
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:5001
# Optional server-side override; falls back to NEXT_PUBLIC_DASHBOARD_API_URL
DASHBOARD_API_URL=http://localhost:5001
# ── Recall.ai (bot-opnames + Desktop Recording SDK) ──────────────────────────
# API-key van je Recall.ai-workspace (us-west-2). Gebruikt door de bestaande
# bot/agenda-flow én de Desktop Recording SDK (upload-tokens, recording ophalen).
RECALL_API_KEY=
# Svix signing-secret (whsec_...) van het BOT-webhook-endpoint (/api/webhooks/recall)
# in het Recall-dashboard. Elk Svix-endpoint heeft zijn EIGEN secret.
RECALL_WEBHOOK_SECRET=
# Svix signing-secret (whsec_...) van het DESKTOP-SDK-webhook-endpoint
# (/api/webhooks/recall-sdk). Onthul 'm in het Recall-dashboard → Webhooks →
# app.reppic.ai/api/webhooks/recall-sdk → Signing Secret. Zonder deze (of terugval
# op RECALL_WEBHOOK_SECRET) weigert de SDK-webhook alles met 401 "Invalid signature".
RECALL_SDK_WEBHOOK_SECRET=

# App-store reviewer-account: dit adres accepteert óók de vaste OTP-code 000000
# (naast de gemailde code), zodat Google/Apple-reviewers voorbij het inlogscherm
# komen. Leeg laten = uitzondering volledig uit. Zie LEES-DIT-EERST-developer.md (Fix 4).
REVIEW_ACCOUNT_EMAIL=

# ── LMS / Kennisbibliotheek (grotendeels optioneel) ──────────────────────────
# GEEN nieuwe SECRETS nodig: het LMS hergebruikt de LiteLLM-gateway
# (LITELLM_*) voor AI + transcriptie én de bestaande FTP/DAM (FTP_*). De
# variabelen hieronder zijn instellingen met een code-default.
#
# Embedding-model voor semantisch zoeken in de kennisbibliotheek + slimme
# leerpad-matching. Zonder deze variabele: terugval op tekstzoeken.
# LEARNING_EMBEDDINGS_MODEL=text-embedding-3-small
#
# Whisper-model voor AI-modulegeneratie uit audio/video. Loopt via de gateway;
# default openai/whisper-1. (OPENAI_API_KEY is alleen een terugval als de
# gateway ontbreekt.)
# LEARNING_TRANSCRIPTION_MODEL=openai/whisper-1
#
# Pad naar de LibreOffice-binary voor Office→PDF (PowerPoint/Word) in de
# mediabibliotheek en AI-modulegeneratie. Default "libreoffice" (moet op de
# server geïnstalleerd zijn). Zonder LibreOffice degradeert het netjes.
# LIBREOFFICE_PATH=libreoffice
# ── Gespreksvoorbereiding (meeting prep) ─────────────────────────────────────
# AES-256-GCM-sleutel voor encrypted-at-rest opslag van HubSpot-tokens én
# HMAC van de OAuth-state. Genereer met: openssl rand -base64 32
ENCRYPTION_KEY=

# HubSpot OAuth-app (per tenant gekoppeld via Instellingen → Integraties).
# Scopes: crm.objects.contacts.read, crm.objects.companies.read,
# crm.objects.deals.read, crm.objects.notes.read, oauth.
# Redirect-URI moet exact overeenkomen met de app-config in HubSpot:
# https://<host>/api/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=

# ── Agenda-koppeling per verkoper (Recall Calendar v1) ───────────────────────
# Elke verkoper koppelt zijn eigen agenda via Instellingen → Agenda, zodat de
# automatische gespreksvoorbereiding de aankomende afspraken kan lezen.
#
# BELANGRIJK: de client-SECRET van de Google/Microsoft-app hoort NIET hier, maar
# in het Recall-dashboard (us-west-2 → Calendar Integration). Recall doet de
# code-exchange; onze app heeft alleen de (publieke) client-ID nodig om de
# authorize-URL te bouwen. Leeg laten = die knop toont "nog niet beschikbaar".
#
# *** KRITIEK ***: de client-ID hieronder MOET exact dezelfde client zijn als
# waarvan de credentials in het Recall-dashboard staan. Autoriseren gebeurt met
# deze client-ID; Recall wisselt de code in met de client-ID+secret uit zijn
# dashboard. Verschillen die twee, dan geeft Google geen refresh token en faalt
# de koppeling met "refresh_token missing from oAuth response".
#
# Google Cloud Console → OAuth consent screen (extern) + OAuth client ID (Web).
#   Scopes: calendar.events.readonly + userinfo.email
#   Authorized redirect URI (exact): https://us-west-2.recall.ai/api/v1/calendar/google_oauth_callback/
GOOGLE_OAUTH_CLIENT_ID=
# Azure Portal → App registrations. API-permissions: Calendars.Read + User.Read + offline_access.
#   Redirect URI (exact): https://us-west-2.recall.ai/api/v1/calendar/ms_oauth_callback/
MICROSOFT_OAUTH_CLIENT_ID=
# Optioneel: afwijkend e-mailadres van de notetaker-bot (als die als gast in
# afspraken staat). Wordt uit de prospect-herkenning gefilterd zodat de prep op
# de échte klant focust. Default al gefilterd: notetaker@reppic.ai.
NOTETAKER_EMAIL=
