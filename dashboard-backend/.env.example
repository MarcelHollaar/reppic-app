DATABASE_URL="postgresql://user:password@localhost:5432/dashboard_db"
# Generate a strong value: openssl rand -hex 32
SESSION_SECRET=

# Must match Reppic's JWT_SECRET exactly
# Generate a strong value: openssl rand -hex 32 (MUST match between app and dashboard-backend)
JWT_SECRET=

# OpenAI API key for transcript analysis.
# NOTE: the code reads process.env.Reppic_dashboard (NOT OPENAI_API_KEY).
Reppic_dashboard=

# Comma-separated list of allowed Reppic origins for CORS
REPPIC_ORIGIN=http://localhost:3000

# Must match the port used in Reppic's NEXT_PUBLIC_DASHBOARD_API_URL
PORT=5001

# Demo mode: when "true", the AI endpoints accept unauthenticated demo requests.
# Leave unset (or anything other than "true") in production.
ALLOW_DEMO=

# REQUIRED if you use the AssemblyAI auto-import webhook (/api/webhooks/assemblyai).
# The webhook is unauthenticated and trusts the supplied company_id, so it is
# gated by this shared secret. When this is unset the webhook fails closed
# (HTTP 503) and rejects every call. The authenticated transcript push from the
# Reppic app (POST /api/transcripts with a JWT) does NOT use this and keeps
# working regardless.
ASSEMBLYAI_WEBHOOK_SECRET=

# ── Dashboard-analyse via de LiteLLM-gateway (verplicht) ──
# De backend draait nu volledig via de gateway (geen directe OpenAI/gpt-5 meer).
# Reppic_dashboard (OpenAI-key) is niet meer nodig.
LITELLM_BASE_URL=https://llm-reppic.mytestpartner.nl
LITELLM_API_KEY=
# Default dashboard-analysemodel. De superadmin kan dit overrulen via
# Instellingen > Dashboardmodel (opgeslagen in de platform_settings-tabel).
DASHBOARD_LLM_MODEL=twinai/large
# Optioneel: routing/kosten-tag voor de dashboard-analyse (default: baseline).
# DASHBOARD_LLM_TAG=
